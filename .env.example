# Copy to .env and adjust. All values have safe defaults — the app runs with none of them.
# Prefix is AGRISMART_.

# Auth — CHANGE THIS in any real deployment
AGRISMART_JWT_SECRET=dev-secret-change-me
AGRISMART_JWT_EXPIRE_MINUTES=20160

# Database — ML/farm data (SQLite by default; any SQLAlchemy async URL works)
AGRISMART_DATABASE_URL=sqlite+aiosqlite:///./agrismart.db

# MongoDB — user accounts only. Needs a real server running locally (or Atlas);
# tests never touch this (they swap in an in-memory fake, see tests/conftest.py).
AGRISMART_MONGO_URL=mongodb://localhost:27017
AGRISMART_MONGO_DB_NAME=agrismart

# OTP login — demo mode only, no SMS is actually sent. This code is accepted
# for ANY phone number; the /auth/otp/request response also echoes it back
# so the UI can show it to judges.
AGRISMART_OTP_DEMO_CODE=123456

# Module E — GenAI assistant. Leave blank to use the offline knowledge-base fallback.
AGRISMART_GEMINI_API_KEY=
AGRISMART_GEMINI_MODEL=gemini-1.5-flash

# Module E — local speech-to-text for the mic button (faster-whisper, runs on
# this server — never a cloud speech API). First use downloads the model
# (~150MB) once; after that it needs no internet at all. "tiny"/"base"/"small".
AGRISMART_WHISPER_MODEL_SIZE=base
AGRISMART_WHISPER_COMPUTE_TYPE=int8

# Frontend origins allowed by CORS (comma-separated JSON list)
# AGRISMART_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Model inference tuning
AGRISMART_ABSTAIN_TAU=0.40
# AGRISMART_MODEL_ARTIFACTS_DIR=model/artifacts
